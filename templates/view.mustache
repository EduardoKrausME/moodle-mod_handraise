{{!
    @template mod_handraise/view

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-handraise" data-region="handraise-root" data-cmid="{{cmid}}">
    {{#hasintro}}
        <div class="mod-handraise-intro mb-4">{{{intro}}}</div>
    {{/hasintro}}

    {{#canraise}}
        <section class="mod-handraise-student card mb-4" aria-labelledby="handraise-student-title">
            <div class="card-body text-center py-5">
                <h3 id="handraise-student-title" class="h5 mb-3">{{#str}}modulename, mod_handraise{{/str}}</h3>
                <button type="button"
                        class="btn btn-primary btn-lg px-5"
                        data-action="toggle-hand"
                        aria-pressed="{{#inqueue}}true{{/inqueue}}{{^inqueue}}false{{/inqueue}}">
                    <span data-region="toggle-label">
                        {{#inqueue}}{{#str}}lowerhand, mod_handraise{{/str}}{{/inqueue}}
                        {{^inqueue}}{{#str}}raisehand, mod_handraise{{/str}}{{/inqueue}}
                    </span>
                </button>
                <div class="mt-3" aria-live="polite" data-region="student-status">
                    {{#inqueue}}
                        <div class="fw-semibold" data-region="position">
                            {{#str}}positionlabel, mod_handraise, {{position}}{{/str}}
                        </div>
                    {{/inqueue}}
                    <div class="text-muted small" data-region="queue-count">
                        {{#str}}queuecountlabel, mod_handraise, {{queuecount}}{{/str}}
                    </div>
                </div>
            </div>
        </section>
    {{/canraise}}

    {{#canmanage}}
        <section class="mod-handraise-teacher" aria-labelledby="handraise-queue-title">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h3 id="handraise-queue-title" class="h4 mb-0">{{#str}}queue, mod_handraise{{/str}}</h3>
                <span class="badge rounded-pill bg-secondary" data-region="teacher-count">{{queuecount}}</span>
            </div>
            <div aria-live="polite" data-region="queue-container">
                <div class="list-group mod-handraise-queue {{^hasqueue}}d-none{{/hasqueue}}" data-region="queue-list">
                    {{#queue}}
                        <div class="list-group-item d-flex align-items-center gap-3 py-3" data-queue-id="{{id}}">
                            <div class="mod-handraise-position" aria-hidden="true">{{position}}</div>
                            <div class="flex-grow-1 min-width-0">
                                <div class="fw-semibold text-truncate">{{fullname}}</div>
                                <div class="text-muted small">{{requestedat}} · {{waiting}}</div>
                            </div>
                            <button type="button" class="btn btn-outline-success" data-action="serve" data-queue-id="{{id}}">
                                {{#str}}serve, mod_handraise{{/str}}
                            </button>
                        </div>
                    {{/queue}}
                </div>
                <div class="alert alert-light border mb-0 {{#hasqueue}}d-none{{/hasqueue}}" data-region="empty-queue">
                    {{#str}}emptyqueue, mod_handraise{{/str}}
                </div>
            </div>
        </section>
    {{/canmanage}}
</div>
